{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:see:rfc:core-artifacts-001:data_snapshot:1.0",
  "title": "data_snapshot.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_manifest_hash",
    "snapshot_kind",
    "snapshot_hash",
    "captured_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "run_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "snapshot_kind": { "type": "string", "enum": ["STRUCTURED_PACK", "DERIVED_SNAPSHOT"] },
    "snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "captured_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "hash"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
