{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:see:rfc:core-artifacts-001:indicators:1.0",
  "title": "indicators.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_manifest_hash", "indicators"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "run_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indicator_id", "value"],
        "properties": {
          "indicator_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "value": { "type": ["number", "string", "boolean", "null"] },
          "unit": { "type": "string" },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
