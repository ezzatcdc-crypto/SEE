{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:see:rfc:core-artifacts-001:patterns_drift:1.0",
  "title": "patterns_drift.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_manifest_hash", "patterns"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "run_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_id", "state"],
        "properties": {
          "pattern_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "state": { "type": "string", "enum": ["NEW", "CONTINUING", "DRIFTING", "ENDED"] },
          "delta": { "type": ["number", "string", "null"] },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "severity": { "type": "number", "minimum": 0 },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
