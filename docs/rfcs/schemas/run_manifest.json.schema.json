{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:see:rfc:core-artifacts-001:run_manifest:1.0",
  "title": "run_manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "admission",
    "engine",
    "doctrine",
    "produced_at",
    "run_manifest_hash"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "status": { "type": "string", "enum": ["SUCCEEDED", "FAILED"] },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingested_at"],
      "properties": {
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "doctrine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "produced_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "run_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_snapshot.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "indicators.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "patterns_drift.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "timeline.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "registry/index.json": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUCCEEDED" } }, "required": ["status"] },
      "then": { "required": ["artifacts"], "not": { "required": ["failure"] } }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": {
        "required": ["failure"],
        "properties": {
          "artifacts": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
