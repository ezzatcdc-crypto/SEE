{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:see:rfc:core-artifacts-001:timeline:1.0",
  "title": "timeline.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_manifest_hash", "events"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "run_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "t", "kind"],
        "properties": {
          "event_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "t": { "type": "string", "format": "date-time", "pattern": "Z$" },
          "kind": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "ref": { "type": "string", "minLength": 1 },
          "payload": { "type": "object", "additionalProperties": false }
        }
      }
    }
  }
}
