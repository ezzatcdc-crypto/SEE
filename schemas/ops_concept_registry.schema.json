{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPS Concept Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "version", "issued_at", "concepts"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "registry_id": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string" },
    "source_ref": { "type": "string" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept_id", "name", "definition"],
        "properties": {
          "concept_id": { "type": "string", "pattern": "^[A-Z0-9_\\-]{3,64}$" },
          "name": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9_\\-]{3,64}$" }
          },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "non_examples": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
