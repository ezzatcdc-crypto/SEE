@@
name: SEE Freeze Integrity Check
on:
  push:
    branches: [ main ]
  pull_request:
jobs:
  integrity:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Ensure frozen architecture exists
        run: |
          if [ ! -f SEE_SYSTEM_ARCHITECTURE_FREEZE_v1.zip ]; then
            echo "Frozen architecture bundle missing."
            exit 1
          fi

